{
    "name": "kokonuts/perfex-crm",
    "description": "Perfex CRM application dependencies and developer tooling",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.0",
        "bacon/bacon-qr-code": "^3.0",
        "bainternet/php-hooks": "^1.0",
        "authorizenet/authorizenet": "2.0.2",
        "cocur/slugify": "^4.0",
        "ddeboer/imap": "1.14.2",
        "erusev/parsedown": "^1.7",
        "greew/oauth2-azure-provider": "^1.0",
        "guzzlehttp/guzzle": "^7.4",
        "illuminate/collections": "^10.0",
        "instamojo/instamojo-php": "^0.3.0",
        "league/oauth2-google": "^4.0",
        "league/omnipay": "^3.2",
        "nesbot/carbon": "^3.8",
        "neitanod/forceutf8": "~2.0",
        "omnipay/braintree": "~4.0@dev",
        "omnipay/mollie": "^5.0",
        "omnipay/paypal": "^3.0",
        "paypal/paypal-checkout-sdk": "1.0.1",
        "phpmailer/phpmailer": "^6.6.0",
        "pragmarx/google2fa": "^8.0",
        "pusher/pusher-php-server": "^7.0",
        "stevenmaguire/oauth2-microsoft": "^2.2",
        "stripe/stripe-php": "^15.4",
        "studio-42/elfinder": "^2.1",
        "tecnickcom/tcpdf": "^6.2",
        "twilio/sdk": "^6.32",
        "willdurand/email-reply-parser": "^2.8",
        "xemlock/htmlpurifier-html5": "^0.1.11",
        "zbateson/mail-mime-parser": "^1.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "^3.49",
        "phpstan/phpstan": "^1.10",
        "rector/rector": "^1.0",
        "squizlabs/php_codesniffer": "^3.9",
        "symfony/var-dumper": "^6.0"
    },
    "config": {
        "vendor-dir": "application/vendor",
        "bin-dir": "vendor/bin",
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "format": [
            "@php vendor/bin/php-cs-fixer fix"
        ],
        "lint": [
            "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
            "@php vendor/bin/phpcs"
        ],
        "analyse": "@php vendor/bin/phpstan analyse --no-progress --memory-limit=512M"
    },
    "support": {
        "issues": "https://github.com"
    }
}
